#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: SparkyFitness
# Configures NGINX for use with SparkyFitness
# ==============================================================================
declare callback_base

# Where the services SparkyFitness connects to send the browser back to, if
# the user told us. The client shows it as the address to register with them.
# See init-sparkyfitness for how it is made.
callback_base="${SPARKY_FITNESS_OAUTH_CALLBACK_BASE:-}"

# Generate Ingress configuration
bashio::var.json \
    auto_login "^$(bashio::config 'ingress_auto_login')" \
    callback_base "${callback_base}" \
    interface "$(bashio::app.ip_address)" \
    port "^$(bashio::app.ingress_port)" \
    | tempio \
        -template /etc/nginx/templates/ingress.gtpl \
        -out /etc/nginx/servers/ingress.conf

# Generate direct access configuration, if enabled. The mobile app, and
# anything else that is not a browser sitting in front of Home Assistant, needs
# an address of its own: an Ingress path only exists inside a Home Assistant
# session.
#
# What is asked for here is only whether a port was published at all. NGINX
# listens on the container's own 3004 either way, which is the far side of
# whatever mapping the "Network" section sets up.
if bashio::var.has_value "$(bashio::app.port 3004)"; then
    bashio::config.require.ssl

    bashio::var.json \
        callback_base "${callback_base}" \
        certfile "$(bashio::config 'certfile')" \
        keyfile "$(bashio::config 'keyfile')" \
        port "^3004" \
        ssl "^$(bashio::config 'ssl')" \
        | tempio \
            -template /etc/nginx/templates/direct.gtpl \
            -out /etc/nginx/servers/direct.conf
fi
